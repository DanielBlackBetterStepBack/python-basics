    "def sorting_hat(new_students):
    # Качества, определяющие факультеты
    faculties = {
        'Гриффиндор': ['отвага', 'доброта', 'решительность'],
        'Пуффендуй': ['усердие', 'дружелюбие', 'терпимость'],
        'Когтевран': ['знание', 'изобретательность', 'рассудительность'],
        'Слизерин': ['амбиции', 'находчивость', 'целеустремленность']
    }

    # Вспомогательная функция: определяет факультет по качеству
    def get_faculty_by_trait(trait):
        for faculty, traits in faculties.items():
            if trait in traits:
                return faculty
        return None

    sorted_students = {}
    departments = {faculty: 0 for faculty in sorted(faculties)}  # инициализируем счётчики факультетов

    # Распределение учеников
    for student, trait in new_students.items():
        faculty = get_faculty_by_trait(trait)
        if faculty:
            sorted_students[student] = faculty
            departments[faculty] += 1

    # Сортировка студентов по факультету и имени
    sorted_students = dict(sorted(sorted_students.items(), key=lambda x: (x[1], x[0])))

    return sorted_students, departments
\n"
