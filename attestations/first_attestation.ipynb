    "import re

# Функция подсчёта букв (кириллица и латиница)
def count_letters(text):
    return len(re.findall(r'[a-zA-Zа-яА-ЯёЁ]', text))

# Функция подсчёта цифр
def count_digits(text):
    return len(re.findall(r'\d', text))

# Функция подсчёта слов (последовательности букв)
def count_words(text):
    return len(re.findall(r'\b[а-яА-Яa-zA-ZёЁ]+\b', text))

# Главная функция анализа текста
def analyze_text(text):
    return {
        "letters": count_letters(text),
        "digits": count_digits(text),
        "words": count_words(text)
    }

# Основная часть программы
text = input("Введите текст: ")
result = analyze_text(text)

# Вывод результатов
print("\nАнализ текста:")
print(f"Количество букв: {result['letters']}")
print(f"Количество цифр: {result['digits']}")
print(f"Количество слов: {result['words']}")
"
