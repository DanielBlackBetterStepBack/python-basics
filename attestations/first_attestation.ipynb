    "# Зашифрованная строка
my_string = 'nlbolyjccblyszlblzsclnclmxzijc'

# Словарь шифра
secret_dict = {
    'v': 'w',
    'x': 'y',
    'i': 'h',
    'q': 'l',
    'c': 'n',
    'o': 'm',
    'b': 'a',
    'f': 'r',
    'j': 'o',
    's': 'e',
    'z': 't',
    'g': 'k',
    'l': ' ',
    'k': 'c',
    'm': 'p',
    'n': 'i',
    'w': 's',
    'd': 'f',
    'u': 'u',
    'r': 'd',
    'e': 'x',
    'y': 'g'
}

# Расшифровка строки
decrypted_string = ''.join(secret_dict.get(char, char) for char in my_string)

# Вывод результата
print(decrypted_string)
decrypted_string = ''.join(secret_dict.get(char, char) for char in my_string)
"
