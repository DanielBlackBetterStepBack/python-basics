    "import math

class Vector:
    def __init__(self, coordinates):
        self.coordinates = coordinates

    def length(self):
        return math.sqrt(sum(x**2 for x in self.coordinates))

    def dot(self, other):
        if len(self.coordinates) != len(other.coordinates):
            raise ValueError("Vectors must be the same length")
        return sum(a*b for a, b in zip(self.coordinates, other.coordinates))

    def angle_with(self, other):
        dot_product = self.dot(other)
        return math.acos(dot_product / (self.length() * other.length()))

    def add(self, other):
        return Vector([a + b for a, b in zip(self.coordinates, other.coordinates)])

    def subtract(self, other):
        return Vector([a - b for a, b in zip(self.coordinates, other.coordinates)])

    def scale(self, scalar):
        return Vector([scalar * x for x in self.coordinates])

    def is_collinear(self, other):
        ratios = []
        for a, b in zip(self.coordinates, other.coordinates):
            if b == 0:
                if a != 0:
                    return False
            else:
                ratios.append(a / b)
        return all(r == ratios[0] for r in ratios if r is not None)

class Matrix:
    def __init__(self, data):
        self.data = data

    def add(self, other):
        return Matrix([[self.data[i][j] + other.data[i][j] for j in range(len(self.data[0]))] for i in range(len(self.data))])

    def subtract(self, other):
        return Matrix([[self.data[i][j] - other.data[i][j] for j in range(len(self.data[0]))] for i in range(len(self.data))])

    def multiply_vector(self, vector):
        return Vector([sum(a * b for a, b in zip(row, vector.coordinates)) for row in self.data])

    def multiply_matrix(self, other):
        return Matrix([[sum(a * b for a, b in zip(self_row, col)) for col in zip(*other.data)] for self_row in self.data])

    def transpose(self):
        return Matrix([list(row) for row in zip(*self.data)])

    def determinant(self):
        if len(self.data) != len(self.data[0]):
            raise ValueError("Matrix must be square")
        return self._determinant(self.data)

    def _determinant(self, m):
        if len(m) == 1:
            return m[0][0]
        if len(m) == 2:
            return m[0][0]*m[1][1] - m[0][1]*m[1][0]
        det = 0
        for c in range(len(m)):
            det += ((-1)**c) * m[0][c] * self._determinant([row[:c] + row[c+1:] for row in m[1:]])
        return det

    def gauss_solve(self, b):
        n = len(self.data)
        a = [row[:] for row in self.data]
        b = b[:]
        for i in range(n):
            max_row = max(range(i, n), key=lambda r: abs(a[r][i]))
            a[i], a[max_row] = a[max_row], a[i]
            b[i], b[max_row] = b[max_row], b[i]
            for j in range(i+1, n):
                ratio = a[j][i] / a[i][i]
                for k in range(i, n):
                    a[j][k] -= ratio * a[i][k]
                b[j] -= ratio * b[i]
        x = [0] * n
        for i in range(n-1, -1, -1):
            x[i] = (b[i] - sum(a[i][j] * x[j] for j in range(i+1, n))) / a[i][i]
        return x

class EquationSolver:
    def solve_linear(self, a, b):
        if a == 0:
            raise ValueError("No solution or infinite solutions")
        return -b / a

    def solve_quadratic(self, a, b, c):
        d = b**2 - 4*a*c
        if d < 0:
            return []
        elif d == 0:
            return [-b / (2*a)]
        else:
            sqrt_d = math.sqrt(d)
            return [(-b + sqrt_d) / (2*a), (-b - sqrt_d) / (2*a)]

    def solve_system(self, matrix, vector):
        return Matrix(matrix).gauss_solve(vector)

